[Unit]
Description=Serve the Revit Model MCP documentation on the LAN
Documentation=file://@ROOT@/scripts/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=SITE_STATE_DIR=@STATE@
ExecStartPre=/usr/bin/test -f @ROOT@/site/index.html
ExecStart=/usr/bin/python3 @ROOT@/scripts/serve-site.py @PORT@ @ROOT@/site
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
